{
  "name": "simulated-wallet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.7"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
